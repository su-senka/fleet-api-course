<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Maintenance module. This project is named in the module's InternalsVisibleTo, so
    tests can reach internal services and entities directly - no artificially public types just
    to make them testable.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fleet.Modules.Maintenance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Maintenance\Fleet.Modules.Maintenance\Fleet.Modules.Maintenance.csproj" />
  </ItemGroup>

  <!-- Maintenance reads the Vehicles contracts, so a container holding only Maintenance cannot
       be built. The registration test wires both up, exactly as a host does. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Vehicles\Fleet.Modules.Vehicles\Fleet.Modules.Vehicles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
