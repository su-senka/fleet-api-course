<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Notifications module. This project is named in the module's InternalsVisibleTo, so
    tests can reach internal services and entities directly - no artificially public types just
    to make them testable.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fleet.Modules.Notifications.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Notifications\Fleet.Modules.Notifications\Fleet.Modules.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
