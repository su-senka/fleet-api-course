<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Reporting module. This project is named in the module's InternalsVisibleTo, so
    tests can reach internal services and entities directly - no artificially public types just
    to make them testable.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fleet.Modules.Reporting.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Reporting\Fleet.Modules.Reporting\Fleet.Modules.Reporting.csproj" />
  </ItemGroup>

  <!-- Reporting reads Vehicles and Bookings through their contracts, and writes to the blob
       store, so a container holding only Reporting cannot be built. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Vehicles\Fleet.Modules.Vehicles\Fleet.Modules.Vehicles.csproj" />
    <ProjectReference Include="..\..\src\Modules\Bookings\Fleet.Modules.Bookings\Fleet.Modules.Bookings.csproj" />
    <ProjectReference Include="..\..\src\Modules\Drivers\Fleet.Modules.Drivers\Fleet.Modules.Drivers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
