<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests for the reference slice: real HTTP over a real host.

    Testcontainers gives each run a throwaway Postgres, seeded exactly as `make reset` would seed
    it. Authentication is replaced with a header-driven test scheme - see TestAuthHandler - because
    standing up Keycloak to prove that a 403 is a 403 would be a poor trade.

    When Docker is not running these skip rather than fail.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fleet.Api.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fleet.Api\Fleet.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
