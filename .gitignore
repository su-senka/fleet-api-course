# Build output
bin/
obj/

# On macOS and Linux, `dotnet ef` can create a directory whose name literally contains a
# backslash - "bin\Debug" as a single path segment - which the bin/ rule above does not match.
# The backslash has to be escaped, because gitignore otherwise reads it as an escape character.
bin\\Debug/
bin\\Release/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# Test / coverage
TestResults/
coverage/
*.coverage
*.trx

# Local secrets and overrides
appsettings.Local.json
docker-compose.override.yml
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Local data volumes (docker compose uses named volumes, but just in case)
.data/
