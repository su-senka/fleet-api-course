{
  "realm": "fleet",
  "enabled": true,
  "displayName": "Fleet",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "fleet.admin",
        "description": "Full access to every resource."
      },
      {
        "name": "fleet.dispatcher",
        "description": "Creates and cancels bookings for any driver."
      },
      {
        "name": "fleet.driver",
        "description": "Reads and manages only their own bookings."
      }
    ]
  },
  "clients": [
    {
      "clientId": "fleet-api",
      "name": "Fleet API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5100/*",
        "http://localhost:5101/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fleet-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "employee-number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "employee_number",
            "claim.name": "employee_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
