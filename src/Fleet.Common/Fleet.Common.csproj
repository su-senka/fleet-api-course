<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared kernel.

    Two rules, both enforced by Fleet.Architecture.Tests:
      1. This project must never reference a module. Dependencies point inwards, always.
      2. This project must never reference ASP.NET Core. Modules depend on it, and modules are
         not allowed to know that HTTP exists.

    Microsoft.Extensions.* abstractions are fine and deliberately allowed: dependency injection,
    configuration, logging and hosting are not web frameworks. A console app uses all four.
  -->
  <PropertyGroup>
    <RootNamespace>Fleet.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
