<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Bookings module implementation. Owns the "bookings" Postgres schema and nothing else.
    Types in here are internal wherever possible; the module speaks to the outside world through
    Fleet.Modules.Bookings.Contracts.
  -->
  <PropertyGroup>
    <RootNamespace>Fleet.Modules.Bookings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Modules.Bookings.Contracts\Fleet.Modules.Bookings.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Modules.Bookings.Tests" />
  </ItemGroup>

</Project>
