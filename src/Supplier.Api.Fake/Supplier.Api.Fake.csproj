<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A deliberately unreliable upstream, in one file, with no database.
    Students point their week-12 resilience pipeline at it and watch the circuit breaker open.
  -->
  <PropertyGroup>
    <RootNamespace>Supplier.Api.Fake</RootNamespace>
  </PropertyGroup>

  <!--
    Serilog only, and only so that every failure this service invents lands in Seq next to the
    log lines from the API that called it. Correlating "my circuit breaker opened" with "the
    upstream returned 500 three times in a row" is the whole point of the week-12 exercise, and
    it is much harder across two separate log streams.
  -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
  </ItemGroup>

</Project>
